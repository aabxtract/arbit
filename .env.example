# Copy to .env and fill in after deploy. NEVER commit .env
PRIVATE_KEY=your_deployer_wallet_private_key
# Mainnet (chain ID 4663) — official RPC per docs.robinhood.com/chain
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Testnet (chain ID 46630) — faucet: faucet.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# After token launch on Programmable.market
ARBT_TOKEN_ADDRESS=
# ARBT_ADDRESS=<same as ARBT_TOKEN_ADDRESS> (alias read by demo scripts)

# Existing Uniswap v4 PoolManager on the target chain
POOL_MANAGER_ADDRESS=

# Filled in by DeployArbit.s.sol
REGISTRY_ADDRESS=
HOOK_ADDRESS=
# Fund HOOK_ADDRESS with ARBT after deploy — rewards, victim payouts, and
# burns are backed by the hook's real balance and revert when unfunded.

# Pool config (JSON) — pool MUST use the dynamic-fee flag or the beforeSwap
# fee return is silently ignored (see guide). key.toId() is what
# registry.allowPool expects.
POOL_KEY_JSON={"currency0":"0x...","currency1":"0x...","fee":8388608,"tickSpacing":10,"hooks":"0x..."}
# 8388608 = 0x800000 = LPFeeLibrary.DYNAMIC_FEE_FLAG

# Per demo agent executor (optional — routers may pass the user as 32-byte
# hookData instead; see demo/README.md)
EXECUTOR_ADDRESS=
